# .gitignore — MarketSense
# 原则：禁止提交训练数据、模型 checkpoint、缓存、日志、临时文件、本地环境文件、密钥。

# --- 训练/实验数据与模型产物（防泄漏防护网，后续 Spec 可细化） ---
data/
datasets/
checkpoints/
runs/
artifacts/
*.csv
*.tsv
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/

# --- 日志与临时文件 ---
logs/
*.log
tmp/
*.tmp
*.swp

# --- 环境与密钥 ---
.env
.env.*
*.key
*.pem
secrets/

# --- 系统 / 编辑器 ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- dataset 子应用：本地凭证配置（D-03 / AGENTS.md §12 凭证不入库） ---
dataset/config/*.local.yaml
dataset/config/*.local.yml
